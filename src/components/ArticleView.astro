---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  date: Date;
  body: string;
  original?: string;
}
const { lang, title, date, body, original } = Astro.props;
const locale = lang === 'pt-br' ? 'pt-BR' : 'en-US';
const fmt = new Intl.DateTimeFormat(locale, {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
const words = body.trim().split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));
const timeValue = lang === 'pt-br' ? `${minutes} min de leitura` : `${minutes} min read`;
const originalLabel = `${title} (Original)`;
---

<article class="article">
  <header class="article__intro">
    <h1 class="article__title">{title}</h1>
    <dl class="case__facts">
      <div class="case__fact">
        <dt>date</dt>
        <dd>{fmt}</dd>
      </div>
      <div class="case__fact">
        <dt>time</dt>
        <dd>{timeValue}</dd>
      </div>
    </dl>
  </header>

  <div class="article__body prose">
    <slot />
  </div>

  {
    original ? (
      <a
        class="article__original"
        href={original}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>{originalLabel}</span>
        <img
          class="icon-arrow"
          src={`${import.meta.env.BASE_URL}icons/arrow-link.svg`}
          alt=""
          width="20"
          height="20"
        />
      </a>
    ) : null
  }
</article>

<script>
  function captionFigures() {
    document.querySelectorAll<HTMLElement>('.article .prose p:has(> img:only-child)').forEach((p) => {
      if (p.nextElementSibling?.classList.contains('article__caption')) return;
      const img = p.querySelector('img');
      const alt = img?.getAttribute('alt')?.trim();
      if (!alt) return;
      const caption = document.createElement('p');
      caption.className = 'article__caption';
      caption.textContent = alt;
      p.after(caption);
    });
  }

  captionFigures();
  document.addEventListener('astro:page-load', captionFigures);
</script>

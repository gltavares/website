---
import { type Lang } from '../i18n/ui';
import { useTranslations, localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  date: Date;
  kind: string;
}
const { lang, title, date, kind } = Astro.props;
const t = useTranslations(lang);
const locale = lang === 'pt-br' ? 'pt-BR' : 'en-US';
const fmt = new Intl.DateTimeFormat(locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href={localePath(lang, '')}>{t('breadcrumb.home')}</a>
  <span class="breadcrumb__sep">/</span>
  <span aria-current="page">{title}</span>
</nav>

<article class="article">
  <header class="article__header">
    <h1 class="article__title">{title}</h1>
    <div class="article__meta">{fmt} · {kind}</div>
  </header>
  <div class="prose">
    <slot />
  </div>
</article>

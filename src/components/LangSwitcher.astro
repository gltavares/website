---
import { type Lang } from '../i18n/ui';
import { alternatePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  path: string;
  /** Explicit destination for the other locale (e.g. a translated article). */
  altPath?: string;
}
const { lang, path, altPath } = Astro.props;

const hrefFor = (code: Lang) =>
  code === lang ? path : (altPath ?? alternatePath(lang, code, path));
---

<nav
  class="lang"
  transition:name="site-lang"
  aria-label={lang === 'pt-br' ? 'Idioma' : 'Language'}
>
  <a class="lang__link" href={hrefFor('pt-br')} aria-current={lang === 'pt-br' ? 'true' : undefined}>
    pt
  </a>
  <span class="lang__sep" aria-hidden="true">|</span>
  <a class="lang__link" href={hrefFor('en')} aria-current={lang === 'en' ? 'true' : undefined}>en</a>
</nav>

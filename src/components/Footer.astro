---
import PhotosDogs from './PhotosDogs.astro';
import LangSwitcher from './LangSwitcher.astro';
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  altPath?: string;
}
const { lang, path, altPath } = Astro.props;
---

<footer class="site-footer">
  <LangSwitcher lang={lang} path={path} altPath={altPath} />
  <PhotosDogs />
</footer>

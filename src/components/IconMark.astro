        fill="currentColor"
        d="M6.4 9.2H3.6v11.2h2.8V9.2ZM5 3.6c-.9 0-1.6.7-1.6 1.6S4.1 6.8 5 6.8s1.6-.7 1.6-1.6S5.9 3.6 5 3.6Zm15.4 8.3c0-2.5-1.3-4.1-3.9-4.1-1.8 0-2.6 1-3.1 1.7V9.2h-2.8c0 1.9 0 11.2 0 11.2h2.8v-6.3c.1-.6.5-1.5 1.5-1.5 1 0 1.4.7 1.4 1.6v6.2h2.8v-6.4c0-2.7-.6-4.1-2.7-4.1Z"
      />

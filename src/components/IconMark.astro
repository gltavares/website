  class="icon-mark"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'work' ? (
      <>
        <rect x="3" y="3" width="8" height="8" rx="1.75" fill="currentColor" />
        <rect x="13" y="3" width="8" height="8" rx="1.75" fill="currentColor" />
        <rect x="3" y="13" width="8" height="8" rx="1.75" fill="currentColor" />
        <rect x="13" y="13" width="8" height="8" rx="1.75" fill="currentColor" />
      </>
    ) : name === 'about' ? (
      <>
        <circle cx="12" cy="8" r="3.4" fill="currentColor" />
        <path
          fill="currentColor"
          d="M5.2 19.8c.5-3.5 3.3-5.5 6.8-5.5s6.3 2 6.8 5.5c.1.6-.4 1.2-1 1.2H6.2c-.6 0-1.1-.6-1-1.2Z"
        />

      <>
        <rect x="3" y="5.5" width="18" height="13" rx="2.2" fill="currentColor" />
        <path
          d="M4.4 7.4 12 13.2l7.6-5.8"
          stroke="#fff"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

---
import { getCollection } from 'astro:content';
import { getProjectCards } from '../data/projects';
import { type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';
import ProjectCard from './ProjectCard.astro';
import TextCard from './TextCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const projects = getProjectCards(lang).map((p) => ({
  type: 'project' as const,
  ...p,
  href: localePath(lang, `work/${p.slug}`),
}));

const texts = (await getCollection('texts', (e) => e.data.lang === lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((e) => ({
    type: 'text' as const,
    id: e.id,
    title: e.data.title,
    kind: e.data.kind,
    tags: e.data.tags,
    subtitle: e.data.subtitle,
    href: e.data.external ?? localePath(lang, `texts/${e.id}`),
    external: Boolean(e.data.external),
  }));

const feed = [];
let ti = 0;
for (const project of projects) {
  feed.push(project);
  if (ti < texts.length) feed.push(texts[ti++]);
}
while (ti < texts.length) feed.push(texts[ti++]);
---

<div class="feed">
  {
    feed.map((item) =>
      item.type === 'project' ? (
        <ProjectCard
          title={item.title}
          accent={item.accent}
          href={item.href}
          media={item.media}
          client={item.client}
          mediaInset={item.mediaInset}
          transitionName={`project-${item.slug}`}
        />
      ) : (
        <TextCard
          title={item.title}
          kind={item.kind}
          href={item.href}
          external={item.external}
          tags={item.tags}
          subtitle={item.subtitle}
          transitionName={item.external ? undefined : `text-${item.id}`}
        />
      ),
    )
  }
</div>

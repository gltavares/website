---
import { getWork } from '../data/work';
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = getWork(lang);
---

<div class="bento">
  {
    items.map((item) => {
      const Tag = item.href ? 'a' : 'div';
      const extra = item.href
        ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' }
        : {};
      return (
        <Tag class={`tile ${item.cls} ${item.light ? 'tile--light' : ''}`} {...extra}>
          <img class="tile__media" src={item.media} alt={item.title} loading="lazy" width="1200" height="900" />
          <div class="tile__body">
            <div class="tile__title">{item.title}</div>
            <div class="tile__meta">{item.meta}</div>
          </div>
        </Tag>
      );
    })
  }
</div>

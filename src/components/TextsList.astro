---
import { getCollection } from 'astro:content';
import { type Lang } from '../i18n/ui';
import { useTranslations, localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = (await getCollection('texts', (e) => e.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const locale = lang === 'pt-br' ? 'pt-BR' : 'en-US';
const fmt = (d: Date) =>
  new Intl.DateTimeFormat(locale, { month: 'short', year: 'numeric' }).format(d);
---

<main>
  <div class="container page-head">
    <h1 class="page-title">{t('texts.title')}</h1>
    <p class="hero__tagline" style="margin-top:16px;">{t('texts.intro')}</p>
  </div>

  <div class="container text-list">
    {
      entries.map((entry) => {
        const href = entry.data.external ?? localePath(lang, `texts/${entry.id}`);
        const external = Boolean(entry.data.external);
        return (
          <a
            class="text-row"
            href={href}
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="text-row__date">{fmt(entry.data.date)}</span>
            <span>
              <span class="text-row__title">{entry.data.title}</span>
              {entry.data.description && (
                <span class="text-row__desc">{entry.data.description}</span>
              )}
            </span>
            <span class="text-row__kind">
              {entry.data.kind}
              {external ? ' ↗' : ''}
            </span>
          </a>
        );
      })
    }
  </div>
</main>

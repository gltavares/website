---
import { type Lang } from '../i18n/ui';
import { useTranslations, localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  active?: 'work' | 'about';
}
const { lang, active } = Astro.props;
const t = useTranslations(lang);
const pt = lang === 'pt-br';
const linkedin = 'https://www.linkedin.com/in/gltavares/';
---

<aside class="sidebar">
  <div class="sidebar__desc">
    {
      pt ? (
        <>
          <p>
            Designer há 11 anos. Traduzindo conceitos em produtos digitais e usando visões
            sistêmicas para evoluir processos com IA.
          </p>
          <p>
            Atualmente trabalhando como especialista no{' '}
            <a href="https://inter.co/" target="_blank" rel="noopener noreferrer">
              Inter
            </a>{' '}
            e como triatleta nas horas vagas.
          </p>
        </>
      ) : (
        <>
          <p>
            Designer for 11 years. Translating concepts into digital products and using systemic
            thinking to evolve processes with AI.
          </p>
          <p>
            Currently working as a specialist at{' '}
            <a href="https://inter.co/" target="_blank" rel="noopener noreferrer">
              Inter
            </a>{' '}
            and as a triathlete in my spare time.
          </p>
        </>
      )
    }
  </div>

  <nav class="chips" aria-label={pt ? 'Navegação' : 'Navigation'}>
    <a class="chip" href={localePath(lang, '')} aria-current={active === 'work' ? 'page' : undefined}>
      {t('nav.work')}
    </a>
    <a
      class="chip"
      href={localePath(lang, 'about')}
      aria-current={active === 'about' ? 'page' : undefined}
    >
      {t('nav.about')}
    </a>
    <a class="chip chip--link" href={linkedin} target="_blank" rel="noopener noreferrer">
      LinkedIn
    </a>
  </nav>
</aside>

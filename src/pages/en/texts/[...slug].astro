---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArticleView from '../../../components/ArticleView.astro';
import { localePath } from '../../../i18n/utils';

export async function getStaticPaths() {
  const entries = await getCollection('texts', (e) => e.data.lang === 'en' && !e.data.external);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Point the language switcher at the PT-BR translation when one exists,
// otherwise fall back to the PT-BR Texts index.
const ptMatch = entry.data.translationKey
  ? (await getCollection('texts', (e) => e.data.lang === 'pt-br')).find(
      (e) => e.data.translationKey === entry.data.translationKey,
    )
  : undefined;
const altPath = ptMatch
  ? ptMatch.data.external ?? localePath('pt-br', `texts/${ptMatch.id}`)
  : localePath('pt-br', 'texts');
---

<Base
  lang="en"
  title={`${entry.data.title} — Gabriel Tavares`}
  active="texts"
  description={entry.data.description}
  altPath={altPath}
>
  <ArticleView lang="en" title={entry.data.title} date={entry.data.date} kind={entry.data.kind}>
    <Content />
  </ArticleView>
</Base>

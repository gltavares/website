---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  active?: 'work' | 'texts';
  /** Explicit destination for the language switcher's other locale. */
  altPath?: string;
}
const { lang, title, description, active, altPath } = Astro.props;
const htmlLang = lang === 'pt-br' ? 'pt-BR' : 'en';
const path = Astro.url.pathname;
const desc =
  description ??
  (lang === 'pt-br'
    ? 'Portfólio e textos de Gabriel Tavares, product designer.'
    : 'Portfolio and writing of Gabriel Tavares, product designer.');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header lang={lang} active={active} path={path} altPath={altPath} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>

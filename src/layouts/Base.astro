---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { type Lang } from '../i18n/ui';
import { localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  active?: 'work' | 'about';
  /** Explicit destination for the language switcher's other locale. */
  altPath?: string;
}
const { lang, title, description, active, altPath } = Astro.props;
const htmlLang = lang === 'pt-br' ? 'pt-BR' : 'en';
const path = Astro.url.pathname;
const desc =
  description ??
  (lang === 'pt-br'
    ? 'Portfólio e textos de Gabriel Tavares, product designer.'
    : 'Portfolio and writing of Gabriel Tavares, product designer.');
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fustat:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="masthead">
      <a href={localePath(lang, '')} aria-label="Gabriel Tavares">
        <span class="masthead__name">
          <span>Gabriel</span>
          <span>Tavares</span>
        </span>
      </a>
    </header>

    <div class="layout">
      <Sidebar lang={lang} active={active} />
      <div class="content">
        <slot />
      </div>
    </div>

    <Footer lang={lang} path={path} altPath={altPath} />
  </body>
</html>
